# ---- Database ----
# Leave empty for local development: a file-based Postgres (PGlite) is used in ./data/pglite.
# In production set a real Postgres URL (Supabase, Neon, etc.).
DATABASE_URL=

# ---- Site ----
# Public address of the site. Needed for payment callbacks.
SITE_URL=http://localhost:3000

# Phone numbers (8 digits, comma-separated) that get admin access when they log in.
ADMIN_PHONES=99119911

# Delivery fee in tugrik for Ulaanbaatar orders.
DELIVERY_FEE=5000

# ---- SMS (login codes) ----
# console = print codes to the server log and show them on the login page (development only).
SMS_PROVIDER=console

# ---- Payments ----
# mock = test mode with a "simulate payment" button. qpay = real QPay (needs the credentials below).
PAYMENT_PROVIDER=mock

# QPay v2 merchant credentials (issued by QPay after merchant registration).
# Sandbox endpoint for testing: https://merchant-sandbox.qpay.mn/v2
QPAY_ENDPOINT=https://merchant.qpay.mn/v2
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=

# ---- Online preview ----
# When set, the whole site asks for this password (any username). Leave empty locally.
PREVIEW_PASSWORD=
